39071>>>    Procedure SetActionButtons
39074>>>        tWebNavigateData NavigateData
39074>>>        tWebNavigateData NavigateData
39074>>>        Boolean bHasRecord
39074>>>        Handle hoDD
39074>>>
39074>>>        Get Server to hoDD
39075>>>        Get GetNavigateData to NavigateData
39076>>>        Get HasRecord of hoDD to bHasRecord
39077>>>
39077>>>        // let's hide all buttons and then Show the ones we want
39077>>>        WebSet pbRender of oEditBtn to False
39078>>>        WebSet pbRender of oSaveBtn to False
39079>>>        WebSet pbRender of oCancelChangesBtn to False
39080>>>        WebSet pbRender of oDeleteBtn to False
39081>>>
39081>>>        If (NavigateData.bReadOnly) Begin
39083>>>            WebSet pbRender of oEditBtn to True
39084>>>        End
39084>>>>
39084>>>        Else Begin
39085>>>            WebSet pbRender of oSaveBtn to True
39086>>>            WebSet pbRender of oCancelChangesBtn to True
39087>>>            WebSet pbRender of oDeleteBtn to bHasRecord
39088>>>        End
39088>>>>
39088>>>    End_Procedure
39089>>>
39089>>>    Procedure OnViewSaved Handle hoServer Boolean bChanged
39092>>>        // Close after save
39092>>>        Send NavigateClose Self
39093>>>    End_Procedure
39094>>>
39094>>>    // this will close the view after a delete
39094>>>    Procedure OnViewDeleted Handle hoDDO
39097>>>        Send NavigateClose Self
39098>>>    End_Procedure
39099>>>
39099>>>    /*Es un evento de la vista y pregunta que quieres hacer al llegar a esa vista. Hay que ponerle el parametro de entrada    de la información que se le está pasando, tienen informacion de la vista que me esta invocando (Integer hoInvokingView)    y tiene la información del objeto que me está invocando (Integer hoInvokingObject).    Analogia -Viaje en tren Malaga a Madrid-: OnNavigateForward=Madrid; hoInvokingView=Malaga; hoInvokingObject=Tren;     tWebNavigateData y NavigateData= Maletas, reserva hotel,...  */
39099>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
39102>>>        Case Begin
39102>>>            Case (NavigateData.eNavigateType = nfFromMain)
39104>>>                // If from main, this is a propbably a main file Select to Zoom.
39104>>>                Case Break
39105>>>
39105>>>            Case (NavigateData.eNavigateType = nfFromParent)
39108>>>                // If from parent, this is a constrained drill down.
39108>>>                Case Break
39109>>>
39109>>>            Case (NavigateData.eNavigateType = nfFromChild)
39112>>>                // If from child, this is a probably a parent Zoom from a Zoom.
39112>>>                Case Break
39113>>>
39113>>>            Case Else // must be nfUndefined
39113>>>
39113>>>        Case End
39113>>>
39113>>>        Send SetActionButtons
39114>>>        
39114>>>        /* Esto es lo que se pone por defecto en un zoom: Si he venido al zoomEntrenador, seleccionando un entrenador ponme el nombre,         si no hay un record es que vienes de viewnewrecord por lo tanto pon Nuevo entrenador */
39114>>>        If (HasRecord(Server(Self))) Begin
39116>>>            Send SetHeaderCaption   ("Entrenador:"*entrenador.Nombre)
39117>>>            Send SetBreadcrumbCaption entrenador.Nombre
39118>>>        End
39118>>>>
39118>>>        Else Begin
39119>>>            Send SetHeaderCaption   "Nuevo entrenador"
39120>>>            Send SetBreadcrumbCaption "Nuevo"
39121>>>        End 
39121>>>>
39121>>>    End_Procedure
39122>>>
39122>>>End_Object 
