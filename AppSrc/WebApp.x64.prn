37757>>>>>Class cjugadorDataDictionary is a DataDictionary
37758>>>>>    
37758>>>>>    Procedure Construct_Object
37760>>>>>        Forward Send Construct_Object
37762>>>>>        Set Main_File to jugador.File_Number //asociar un DD a una unica tabla y no se puede tocar
37763>>>>>              
37763>>>>>      //Estos son los tipos de relaciones que tiene con otros DD
37763>>>>>        Set Add_Server_File to equipo.File_Number           //este DD (jugador) apunta al DD (equipo) hijo a padre
37764>>>>>        Set ParentNullAllowed  equipo.File_Number to True   //Puede tener un padre nulleable   
37765>>>>>        
37765>>>>>        Set Add_Client_File to hijojugador.File_Number      //este DD (jugador) esta apuntado por el DD (hijojugador) padre a hijo       
37766>>>>>        Set Add_Client_File to jugadorposicion.File_Number  //este DD (jugador) esta apuntado por el DD (jugadorposicion) padre a hijo   
37767>>>>>       
37767>>>>>       //Como se comportan los datos de esta tabla si son usados como FK
37767>>>>>        Set Foreign_Field_Option DD_KEYFIELD DD_NOPUT to True
37768>>>>>        Set Foreign_Field_Option DD_KEYFIELD DD_FINDREQ to True
37769>>>>>        Set Foreign_Field_Option DD_INDEXFIELD DD_NOPUT to True
37770>>>>>        Set Foreign_Field_Option DD_DEFAULT DD_DISPLAYONLY to True
37771>>>>>        
37771>>>>>        //Jugador ID es un Field State= Primary Key. y hace dos cosas: le dice que este campo es PK y lo va a proteger
37771>>>>>        Set Key_Field_State Field jugador.ID to True
37772>>>>>
37772>>>>>        Set Field_Value_Table Field jugador.Nacionalidad to oNacionalidad_Val
37773>>>>>
37773>>>>>    End_Procedure
37774>>>>>End_Class
