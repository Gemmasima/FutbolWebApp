39272>>>        Case Begin
39272>>>            Case (NavigateData.eNavigateType = nfFromMain)
39274>>>                // If from main, this is a propbably a main file Select to Zoom.
39274>>>                Case Break
39275>>>
39275>>>            Case (NavigateData.eNavigateType = nfFromParent)
39278>>>                // If from parent, this is a constrained drill down.
39278>>>                Case Break
39279>>>
