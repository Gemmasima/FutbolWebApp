38006>>>>>        WebSet pbRender of oEditBtn to False
38007>>>>>        WebSet pbRender of oSaveBtn to False
38008>>>>>        WebSet pbRender of oCancelChangesBtn to False
38009>>>>>        WebSet pbRender of oDeleteBtn to False
38010>>>>>
38010>>>>>        If (NavigateData.bReadOnly) Begin
38012>>>>>            WebSet pbRender of oEditBtn to True
38013>>>>>        End
38013>>>>>>
38013>>>>>        Else Begin
38014>>>>>            WebSet pbRender of oSaveBtn to True
38015>>>>>            WebSet pbRender of oCancelChangesBtn to True
38016>>>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38017>>>>>        End
38017>>>>>>
38017>>>>>    End_Procedure
