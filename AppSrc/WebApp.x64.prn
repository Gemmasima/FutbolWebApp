39076>>>    // this will close the view after a delete
39076>>>    Procedure OnViewDeleted Handle hoDDO
39079>>>        Send NavigateClose Self
39080>>>    End_Procedure
39081>>>
39081>>>    /*Es un evento de la vista y pregunta que quieres hacer al llegar a esa vista. Hay que ponerle el parametro de entrada    de la información que se le está pasando, tienen informacion de la vista que me esta invocando (Integer hoInvokingView)    y tiene la información del objeto que me está invocando (Integer hoInvokingObject).    Analogia -Viaje en tren Malaga a Madrid-: OnNavigateForward=Madrid; hoInvokingView=Malaga; hoInvokingObject=Tren;     tWebNavigateData y NavigateData= Maletas, reserva hotel,...  */
39081>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
39084>>>        Case Begin
39084>>>            Case (NavigateData.eNavigateType = nfFromMain)
39086>>>                // If from main, this is a propbably a main file Select to Zoom.
39086>>>                Case Break
39087>>>
39087>>>            Case (NavigateData.eNavigateType = nfFromParent)
39090>>>                // If from parent, this is a constrained drill down.
39090>>>                Case Break
39091>>>
39091>>>            Case (NavigateData.eNavigateType = nfFromChild)
39094>>>                // If from child, this is a probably a parent Zoom from a Zoom.
39094>>>                Case Break
39095>>>
39095>>>            Case Else // must be nfUndefined
39095>>>
39095>>>        Case End
39095>>>
39095>>>        Send SetActionButtons
39096>>>        
39096>>>        /* Esto es lo que se pone por defecto en un zoom: Si he venido al zoomEntrenador, seleccionando un entrenador ponme el nombre,         si no hay un record es que vienes de viewnewrecord por lo tanto pon Nuevo entrenador */
39096>>>        If (HasRecord(Server(Self))) Begin
39098>>>            Send SetHeaderCaption   ("Entrenador:"*entrenador.Nombre)
39099>>>            Send SetBreadcrumbCaption entrenador.Nombre
39100>>>        End
39100>>>>
39100>>>        Else Begin
39101>>>            Send SetHeaderCaption   "Nuevo entrenador"
39102>>>            Send SetBreadcrumbCaption "Nuevo"
39103>>>        End 
39103>>>>
39103>>>    End_Procedure
39104>>>
39104>>>End_Object 
