39296>>>        End
39296>>>>
39296>>>        Else Begin
39297>>>            WebSet pbRender of oSaveBtn to True
39298>>>            WebSet pbRender of oCancelChangesBtn to True
39299>>>            WebSet pbRender of oDeleteBtn to bHasRecord
39300>>>        End
