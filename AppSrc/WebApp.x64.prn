37743>>>>>      
37743>>>>>      //Estos son los tipos de relaciones que tiene con otros DD
37743>>>>>        Set Add_Server_File to equipo.File_Number           //este DD (jugador) apunta al DD (equipo) hijo a padre
37744>>>>>        Set Add_Client_File to hijojugador.File_Number      //este DD (jugador) esta apuntado por el DD (hijojugador) padre a hijo       
