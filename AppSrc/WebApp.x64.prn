37746>>>>>        Set Foreign_Field_Option DD_KEYFIELD DD_NOPUT to True
37747>>>>>        Set Foreign_Field_Option DD_KEYFIELD DD_FINDREQ to True
37748>>>>>        Set Foreign_Field_Option DD_INDEXFIELD DD_NOPUT to True
37749>>>>>        Set Foreign_Field_Option DD_DEFAULT DD_DISPLAYONLY to True
37750>>>>>        
