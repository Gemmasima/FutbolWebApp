38830>>>    Procedure SetActionButtons
38833>>>        tWebNavigateData NavigateData
38833>>>        tWebNavigateData NavigateData
38833>>>        Boolean bHasRecord
38833>>>        Handle hoDD
38833>>>
38833>>>        Get Server to hoDD
38834>>>        Get GetNavigateData to NavigateData
38835>>>        Get HasRecord of hoDD to bHasRecord
38836>>>
38836>>>        // let's hide all buttons and then Show the ones we want
38836>>>        WebSet pbRender of oEditBtn to False
38837>>>        WebSet pbRender of oSaveBtn to False
38838>>>        WebSet pbRender of oCancelChangesBtn to False
38839>>>        WebSet pbRender of oDeleteBtn to False
38840>>>
38840>>>        If (NavigateData.bReadOnly) Begin
38842>>>            WebSet pbRender of oEditBtn to True
38843>>>        End
38843>>>>
38843>>>        Else Begin
38844>>>            WebSet pbRender of oSaveBtn to True
38845>>>            WebSet pbRender of oCancelChangesBtn to True
38846>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38847>>>        End
38847>>>>
38847>>>    End_Procedure
38848>>>
38848>>>    Procedure OnViewSaved Handle hoServer Boolean bChanged
38851>>>        // Close after save
38851>>>        Send NavigateClose Self
38852>>>    End_Procedure
38853>>>
38853>>>    // this will close the view after a delete
38853>>>    Procedure OnViewDeleted Handle hoDDO
38856>>>        Send NavigateClose Self
38857>>>    End_Procedure
38858>>>
38858>>>    /*Es un evento de la vista y pregunta que quieres hacer al llegar a esa vista. Hay que ponerle el parametro de entrada    de la información que se le está pasando, tienen informacion de la vista que me esta invocando (Integer hoInvokingView)    y tiene la información del objeto que me está invocando (Integer hoInvokingObject).    Analogia -Viaje en tren Malaga a Madrid-: OnNavigateForward=Madrid; hoInvokingView=Malaga; hoInvokingObject=Tren;     tWebNavigateData y NavigateData= Maletas, reserva hotel,...  */
38858>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
38861>>>        Case Begin
38861>>>            Case (NavigateData.eNavigateType = nfFromMain)
38863>>>                // If from main, this is a propbably a main file Select to Zoom.
38863>>>                Case Break
38864>>>
38864>>>            Case (NavigateData.eNavigateType = nfFromParent)
38867>>>                // If from parent, this is a constrained drill down.
38867>>>                Case Break
38868>>>
38868>>>            Case (NavigateData.eNavigateType = nfFromChild)
38871>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38871>>>                Case Break
38872>>>
38872>>>            Case Else // must be nfUndefined
38872>>>
38872>>>        Case End
38872>>>
38872>>>        Send SetActionButtons
38873>>>        
38873>>>        /* Esto es lo que se pone por defecto en un zoom: Si he venido al zoomEntrenador, seleccionando un entrenador ponme el nombre,         si no hay un record es que vienes de viewnewrecord por lo tanto pon Nuevo entrenador */
38873>>>        If (HasRecord(Server(Self))) Begin
38875>>>            Send SetHeaderCaption   ("Entrenador:"*entrenador.Nombre)
38876>>>            Send SetBreadcrumbCaption entrenador.Nombre
38877>>>        End
38877>>>>
38877>>>        Else Begin
38878>>>            Send SetHeaderCaption   "Nuevo entrenador"
38879>>>            Send SetBreadcrumbCaption "Nuevo"
38880>>>        End 
38880>>>>
38880>>>    End_Procedure
38881>>>
38881>>>End_Object 
