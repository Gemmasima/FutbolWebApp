39053>>>    Procedure SetActionButtons
39056>>>        tWebNavigateData NavigateData
39056>>>        tWebNavigateData NavigateData
39056>>>        Boolean bHasRecord
39056>>>        Handle hoDD
39056>>>
39056>>>        Get Server to hoDD
39057>>>        Get GetNavigateData to NavigateData
39058>>>        Get HasRecord of hoDD to bHasRecord
39059>>>
39059>>>        // let's hide all buttons and then Show the ones we want
39059>>>        WebSet pbRender of oEditBtn to False
39060>>>        WebSet pbRender of oSaveBtn to False
39061>>>        WebSet pbRender of oCancelChangesBtn to False
39062>>>        WebSet pbRender of oDeleteBtn to False
39063>>>
39063>>>        If (NavigateData.bReadOnly) Begin
39065>>>            WebSet pbRender of oEditBtn to True
39066>>>        End
39066>>>>
39066>>>        Else Begin
39067>>>            WebSet pbRender of oSaveBtn to True
39068>>>            WebSet pbRender of oCancelChangesBtn to True
39069>>>            WebSet pbRender of oDeleteBtn to bHasRecord
39070>>>        End
39070>>>>
39070>>>    End_Procedure
39071>>>
39071>>>    Procedure OnViewSaved Handle hoServer Boolean bChanged
39074>>>        // Close after save
