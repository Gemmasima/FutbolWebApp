39316>>>                // If from main, this is a propbably a main file Select to Zoom.
39316>>>                Case Break
39317>>>
39317>>>            Case (NavigateData.eNavigateType = nfFromParent)
39320>>>                // If from parent, this is a constrained drill down.
39320>>>                Case Break
39321>>>
39321>>>            Case (NavigateData.eNavigateType = nfFromChild)
39324>>>                // If from child, this is a probably a parent Zoom from a Zoom.
39324>>>                Case Break
39325>>>
39325>>>            Case Else // must be nfUndefined
39325>>>
39325>>>        Case End
