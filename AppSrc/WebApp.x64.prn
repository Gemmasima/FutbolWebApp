38267>>>>>        Case Begin
38267>>>>>            Case (NavigateData.eNavigateType = nfFromMain)
38269>>>>>                // If from main, this is a propbably a main file Select to Zoom.
38269>>>>>                Case Break
38270>>>>>
38270>>>>>            Case (NavigateData.eNavigateType = nfFromParent)
38273>>>>>                // If from parent, this is a constrained drill down.
38273>>>>>                Case Break
38274>>>>>
38274>>>>>            Case (NavigateData.eNavigateType = nfFromChild)
38277>>>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38277>>>>>                Case Break
38278>>>>>
38278>>>>>            Case Else // must be nfUndefined
38278>>>>>
38278>>>>>        Case End
38278>>>>>
38278>>>>>        Send SetActionButtons
38279>>>>>        
38279>>>>>         If (HasRecord(Server(Self))) Begin
38281>>>>>            Send SetHeaderCaption   ("Jugador:"*jugador.Nombre)
38282>>>>>            Send SetBreadcrumbCaption jugador.Nombre
38283>>>>>        End
38283>>>>>>
38283>>>>>        Else Begin
38284>>>>>            Send SetHeaderCaption   "Nuevo jugador"
38285>>>>>            Send SetBreadcrumbCaption "Nuevo"
38286>>>>>        End 
38286>>>>>>
38286>>>>>
38286>>>>>    End_Procedure
38287>>>>>
38287>>>>>End_Object 
