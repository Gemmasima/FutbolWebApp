39095>>>    Procedure SetActionButtons
39098>>>        tWebNavigateData NavigateData
39098>>>        tWebNavigateData NavigateData
39098>>>        Boolean bHasRecord
39098>>>        Handle hoDD
39098>>>
39098>>>        Get Server to hoDD
39099>>>        Get GetNavigateData to NavigateData
39100>>>        Get HasRecord of hoDD to bHasRecord
39101>>>
39101>>>        // let's hide all buttons and then Show the ones we want
39101>>>        WebSet pbRender of oEditBtn to False
39102>>>        WebSet pbRender of oSaveBtn to False
39103>>>        WebSet pbRender of oCancelChangesBtn to False
39104>>>        WebSet pbRender of oDeleteBtn to False
39105>>>
39105>>>        If (NavigateData.bReadOnly) Begin
39107>>>            WebSet pbRender of oEditBtn to True
39108>>>        End
39108>>>>
39108>>>        Else Begin
39109>>>            WebSet pbRender of oSaveBtn to True
39110>>>            WebSet pbRender of oCancelChangesBtn to True
39111>>>            WebSet pbRender of oDeleteBtn to bHasRecord
39112>>>        End
39112>>>>
39112>>>    End_Procedure
39113>>>
39113>>>    Procedure OnViewSaved Handle hoServer Boolean bChanged
39116>>>        // Close after save
39116>>>        Send NavigateClose Self
39117>>>    End_Procedure
39118>>>
39118>>>    // this will close the view after a delete
39118>>>    Procedure OnViewDeleted Handle hoDDO
39121>>>        Send NavigateClose Self
39122>>>    End_Procedure
39123>>>
39123>>>    /*Es un evento de la vista y pregunta que quieres hacer al llegar a esa vista. Hay que ponerle el parametro de entrada    de la información que se le está pasando, tienen informacion de la vista que me esta invocando (Integer hoInvokingView)    y tiene la información del objeto que me está invocando (Integer hoInvokingObject).    Analogia -Viaje en tren Malaga a Madrid-: OnNavigateForward=Madrid; hoInvokingView=Malaga; hoInvokingObject=Tren;     tWebNavigateData y NavigateData= Maletas, reserva hotel,...  */
39123>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
39126>>>        Case Begin
39126>>>            Case (NavigateData.eNavigateType = nfFromMain)
39128>>>                // If from main, this is a propbably a main file Select to Zoom.
39128>>>                Case Break
39129>>>
39129>>>            Case (NavigateData.eNavigateType = nfFromParent)
39132>>>                // If from parent, this is a constrained drill down.
39132>>>                Case Break
39133>>>
39133>>>            Case (NavigateData.eNavigateType = nfFromChild)
39136>>>                // If from child, this is a probably a parent Zoom from a Zoom.
39136>>>                Case Break
39137>>>
39137>>>            Case Else // must be nfUndefined
39137>>>
39137>>>        Case End
39137>>>
39137>>>        Send SetActionButtons
39138>>>        
39138>>>        /* Esto es lo que se pone por defecto en un zoom: Si he venido al zoomEntrenador, seleccionando un entrenador ponme el nombre,         si no hay un record es que vienes de viewnewrecord por lo tanto pon Nuevo entrenador */
39138>>>        If (HasRecord(Server(Self))) Begin
39140>>>            Send SetHeaderCaption   ("Entrenador:"*entrenador.Nombre)
39141>>>            Send SetBreadcrumbCaption entrenador.Nombre
39142>>>        End
39142>>>>
39142>>>        Else Begin
39143>>>            Send SetHeaderCaption   "Nuevo entrenador"
39144>>>            Send SetBreadcrumbCaption "Nuevo"
39145>>>        End 
39145>>>>
39145>>>    End_Procedure
39146>>>
39146>>>End_Object 
