38678>>>                    Send NavigateForward of oSelectLiga Self //Liga(Padre)
38679>>>                    Case Break
38680>>>                //Si la navegacion viene de un hijo - Cierra la vista
38680>>>                Case (NavigateData.eNavigateType = nfFromChild)
38683>>>                    Send NavigateClose Self
38684>>>                    Case Break
38685>>>
38685>>>                Case (NavigateData.eNavigateType = nfFromMain)
38688>>>                    Send NavigateClose Self
38689>>>                    Case Break
38690>>>
38690>>>                Case Else // must be nfUndefined
38690>>>                    Send NavigateForward of oSelectLiga Self //Liga(Padre)
38691>>>
38691>>>            Case End
