39286>>>        tWebNavigateData NavigateData
39286>>>        tWebNavigateData NavigateData
39286>>>        Boolean bHasRecord
39286>>>        Handle hoDD
39286>>>
39286>>>        Get Server to hoDD
39287>>>        Get GetNavigateData to NavigateData
39288>>>        Get HasRecord of hoDD to bHasRecord
39289>>>
39289>>>        // let's hide all buttons and then Show the ones we want
39289>>>        WebSet pbRender of oEditBtn to False
39290>>>        WebSet pbRender of oSaveBtn to False
39291>>>        WebSet pbRender of oCancelChangesBtn to False
39292>>>        WebSet pbRender of oDeleteBtn to False
39293>>>
39293>>>        If (NavigateData.bReadOnly) Begin
