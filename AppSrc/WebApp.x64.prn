38208>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
38211>>>        WebSet pbRender of oNewButton to True
38212>>>        WebSet pbRender of oDetailButton to True
38213>>>
38213>>>        Case Begin
38213>>>            Case (NavigateData.eNavigateType = nfFromParent)
38215>>>                // If from parent, this is a constrained drill down
38215>>>                Case Break
38216>>>
38216>>>            Case (NavigateData.eNavigateType = nfFromChild)
38219>>>                // If from child, this is a probably a parent lookup from a Zoom
38219>>>                Case Break
38220>>>
38220>>>            Case (NavigateData.eNavigateType = nfFromMain)
38223>>>                // If from main, this is a probably a main-file lookup from a Zoom
38223>>>                WebSet pbRender of oDetailButton to False
38224>>>                Case Break
38225>>>
38225>>>            Case Else // must be nfUndefined
38225>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
38225>>>
38225>>>        Case End
38225>>>
38225>>>    End_Procedure
38226>>>
38226>>>
38226>>>End_Object 
