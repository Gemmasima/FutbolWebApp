38007>>>>>        WebSet pbRender of oEditBtn to False
38008>>>>>        WebSet pbRender of oSaveBtn to False
38009>>>>>        WebSet pbRender of oCancelChangesBtn to False
38010>>>>>        WebSet pbRender of oDeleteBtn to False
38011>>>>>
38011>>>>>        If (NavigateData.bReadOnly) Begin
